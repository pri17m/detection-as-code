rule dac_gh_0014 {
  meta:
    author = "Detection Engineer"
    description = "GitHub: Org audit log export or webhook sink weakened - hook.destroy org audit-related"
    severity = "High"
    rule_id = "DAC-GH-0014"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1685.002"

  events:
    $e.metadata.log_type = "GITHUB"
    ($e.metadata.product_event_type = "hook.destroy" nocase or $e.metadata.product_event_type = "org.hook.destroy" nocase or $e.metadata.product_event_type = "repo.hook.destroy" nocase)

  condition:
    $e
}
