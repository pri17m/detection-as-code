rule dac_gcp_0013 {
  meta:
    author = "Detection Engineer"
    description = "GCP: storage.objects.copy or rewrite cross-project - storage.objects.copy destination other project"
    severity = "High"
    rule_id = "DAC-GCP-0013"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1537"

  events:
    $e.metadata.log_type = "GCP_CLOUDAUDIT"
    ($e.metadata.product_event_type = "storage.objects.copy" nocase or $e.metadata.product_event_type = "storage.objects.rewrite" nocase)

  condition:
    $e
}
