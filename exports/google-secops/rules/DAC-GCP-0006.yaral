rule dac_gcp_0006 {
  meta:
    author = "Detection Engineer"
    description = "GCP: logging sinks delete or update weaken export - google.logging.v*.ConfigServiceV2.DeleteSink"
    severity = "High"
    rule_id = "DAC-GCP-0006"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1685.002"

  events:
    $e.metadata.log_type = "GCP_CLOUDAUDIT"
    ($e.metadata.product_event_type = "google.logging.v2.ConfigServiceV2.DeleteSink" nocase or $e.metadata.product_event_type = "google.logging.v2.ConfigServiceV2.UpdateSink" nocase)

  condition:
    $e
}
