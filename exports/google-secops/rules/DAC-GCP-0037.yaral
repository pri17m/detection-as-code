rule dac_gcp_0037 {
  meta:
    author = "Detection Engineer"
    description = "GCP: VPC Service Controls perimeter soften or dry-run only - UpdateServicePerimeter"
    severity = "Medium"
    rule_id = "DAC-GCP-0037"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1685"

  events:
    $e.metadata.log_type = "GCP_CLOUDAUDIT"
    $e.metadata.product_event_type = /(?:UpdateServicePerimeter|ServicePerimeter)/ nocase

  condition:
    $e
}
