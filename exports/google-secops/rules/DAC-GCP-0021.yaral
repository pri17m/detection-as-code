rule dac_gcp_0021 {
  meta:
    author = "Detection Engineer"
    description = "GCP: compute.instances.getSerialPortOutput sensitive - GetSerialPortOutput"
    severity = "Medium"
    rule_id = "DAC-GCP-0021"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1651"

  events:
    $e.metadata.log_type = "GCP_CLOUDAUDIT"
    ($e.metadata.product_event_type = /getSerialPortOutput/ nocase or $e.metadata.product_event_type = "v1.compute.instances.getSerialPortOutput" nocase)

  condition:
    $e
}
