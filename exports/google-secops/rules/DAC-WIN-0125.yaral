rule dac_win_0125 {
  meta:
    author = "Detection Engineer"
    description = "Local user account created - Behavior: Local user account created. Anchor is process+flag or event id+field after classic/XML coalesce. Not telemetry_validated. Security 4720"
    severity = "Medium"
    rule_id = "DAC-WIN-0125"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1136.001"
    mitre_attack_technique = "T1098"

  events:
    $e.metadata.log_type = "WINEVTLOG"
    $e.metadata.product_event_type = "4720"

  condition:
    $e
}
