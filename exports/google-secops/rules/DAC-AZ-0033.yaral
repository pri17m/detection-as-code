rule dac_az_0033 {
  meta:
    author = "Detection Engineer"
    description = "Azure: Bastion or JIT access policy weakened - jitNetworkAccessPolicies delete"
    severity = "Medium"
    rule_id = "DAC-AZ-0033"
    source_language = "spl"
    converted_by = "rulebridge"
    mitre_attack_technique = "T1685"

  events:
    $e.metadata.log_type = "AZURE_ACTIVITY"
    ($e.metadata.product_event_type = "Microsoft.Security/locations/jitNetworkAccessPolicies/delete" nocase or $e.metadata.product_event_type = "Microsoft.Security/locations/jitNetworkAccessPolicies/write" nocase)

  condition:
    $e
}
