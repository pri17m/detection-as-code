{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/detection.schema.json",
  "title": "Detection-as-Code unified detection schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "description",
    "author",
    "status",
    "platforms",
    "sourcetypes",
    "mitre",
    "severity",
    "false_positives",
    "references",
    "telemetry_validated",
    "required_fields"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DAC-[A-Z0-9]{2,10}-\\d{4}$"
    },
    "title": { "type": "string", "minLength": 4 },
    "description": { "type": "string", "minLength": 12 },
    "author": { "type": "string", "minLength": 2 },
    "status": {
      "type": "string",
      "enum": ["experimental", "test", "stable"]
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["splunk", "crowdstrike", "defender", "google_secops"] },
      "uniqueItems": true
    },
    "sourcetypes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3 },
      "uniqueItems": true
    },
    "mitre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tactics", "techniques"],
      "properties": {
        "tactics": {
          "type": "array",
          "items": { "type": "string", "minLength": 3 },
          "uniqueItems": true
        },
        "techniques": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T\\d{4}(\\.\\d{3})?$"
          },
          "uniqueItems": true
        }
      }
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "false_positives": {
      "type": "array",
      "items": { "type": "string", "minLength": 3 }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 8 }
    },
    "telemetry_validated": { "type": "boolean" },
    "required_fields": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "splunk": { "type": "string", "minLength": 8 },
        "defender": { "type": "string", "minLength": 8 },
        "crowdstrike": { "type": "string", "minLength": 8 },
        "google_secops": {
          "type": "string",
          "minLength": 8,
          "description": "Google SecOps YARA-L 2.0 rule text"
        }
      }
    },
    "conversions": {
      "type": "object",
      "description": "Provenance for queries produced by a converter rather than written by hand, keyed by query.<platform>",
      "additionalProperties": false,
      "properties": {
        "google_secops": {
          "type": "object",
          "additionalProperties": false,
          "required": ["converter", "converter_version", "source_language", "source_query", "fidelity"],
          "properties": {
            "converter": { "type": "string", "minLength": 2 },
            "converter_version": { "type": "string", "minLength": 1 },
            "converter_commit": { "type": "string", "minLength": 4 },
            "source_language": { "type": "string", "enum": ["spl", "kql", "cql", "yaral", "eql", "esql"] },
            "source_query": { "type": "string", "pattern": "^query\\.[a-z_]+$" },
            "target_language": { "type": "string", "minLength": 2 },
            "fidelity": { "type": "string", "enum": ["exact", "approximate", "needs_human", "llm_assisted"] },
            "score": { "type": "number", "minimum": 0, "maximum": 1 },
            "roundtrip": { "type": "string", "enum": ["agree", "disagree", "unknown", "unchecked"] },
            "syntax_check": { "type": "string" },
            "mapping_pack": { "type": "string" },
            "review": { "type": "string" },
            "caveats": { "type": "array", "items": { "type": "string" } },
            "converted_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        }
      }
    },
    "sigma": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 5 },
        "rule_id": { "type": "string", "minLength": 4 }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["query"] },
        { "required": ["sigma"] }
      ]
    }
  ]
}

